# Build context for every Dockerfile in the monorepo (they all build from the repo root).
# Keep secrets and local artifacts out: anything sent here can end up in an image layer.

# Secrets
.env
.env.*
!.env.example

# Dependencies and build output (rebuilt inside the image)
**/node_modules
**/dist
**/.next
**/coverage
**/*.tsbuildinfo
**/src/generated

# Repository and editor files
.git
.github
.vscode
.idea
**/.DS_Store
*.log
