# Copy to .env and fill in the values. Never commit .env.
# Variables marked "(phase N)" are not used yet; they are listed so the setup is predictable.

# --- General ---
# Leave empty to run only Postgres and Redis in Docker (apps via `pnpm dev`);
# set to `app` to also run migrations, the API and the web app in Docker.
COMPOSE_PROFILES=
NODE_ENV=development
LOG_LEVEL=info

# --- API ---
API_PORT=3001
# Allowed CORS origin (the web app)
WEB_URL=http://localhost:3000

# --- Web ---
WEB_PORT=3000
# Inlined into the browser bundle at build time (rebuild the web image after changing it)
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=knowgate
POSTGRES_PASSWORD=change-me
POSTGRES_DB=knowgate
POSTGRES_PORT=5432
DATABASE_URL=postgresql://knowgate:change-me@localhost:5432/knowgate

# --- Redis (docker-compose) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Auth ---
# At least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=
# Access token lifetime (15 min)
JWT_ACCESS_TTL_SECONDS=900
# Refresh token lifetime (httpOnly cookie, rotated on every use)
REFRESH_TOKEN_TTL_DAYS=7

# --- Rate limiting (requests per minute per IP) ---
RATE_LIMIT_PER_MINUTE=100
# Login and register (brute-force protection)
AUTH_RATE_LIMIT_PER_MINUTE=5

# --- Claude API ---
# anthropic: real answers (needs ANTHROPIC_API_KEY). fake: offline answers quoting the first
# source, no cost (local development without credits; refused in production, required in tests).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# claude-haiku-5-5 (default, cheapest) or claude-opus-5-5 (for eval comparisons).
CLAUDE_MODEL=claude-haiku-5-5
# low | medium | high | xhigh | max. Low keeps short grounded answers fast and cheap.
CLAUDE_EFFORT=low
CLAUDE_MAX_TOKENS=2048

# --- Chat ---
# Minimum cosine similarity (0..1) for a chunk to be sent to Claude. Below it for every chunk,
# the answer is "not found" and the model is not called. Provisional; tuned with the eval.
CHAT_MIN_SIMILARITY=0.4
# Maximum chunks sent to Claude per question.
CHAT_MAX_SOURCES=6

# --- Embeddings ---
# voyage: real embeddings (needs VOYAGE_API_KEY). fake: deterministic offline vectors, no cost
# (local development without credits; refused in production, required in tests).
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
# Must match the vector(N) column in packages/db (changing it requires a migration)
VOYAGE_MODEL=voyage-4-large
EMBEDDING_DIMENSION=1024

# --- Usage limits (phase 3) ---
# Default daily token limit for new organizations
DAILY_TOKEN_LIMIT_DEFAULT=200000

# --- Uploads and chunking ---
# 10 MB
UPLOAD_MAX_BYTES=10485760
# Chunk size and overlap in estimated tokens (~4 characters each); see the README
CHUNK_TARGET_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
