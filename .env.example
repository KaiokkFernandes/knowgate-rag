# Copy to .env and fill in the values. Never commit .env.
# Variables marked "(phase N)" are not used yet; they are listed so the setup is predictable.

# --- General ---
NODE_ENV=development
LOG_LEVEL=info

# --- API ---
API_PORT=3001
# Allowed CORS origin (the web app)
WEB_URL=http://localhost:3000

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=knowgate
POSTGRES_PASSWORD=change-me
POSTGRES_DB=knowgate
POSTGRES_PORT=5432
DATABASE_URL=postgresql://knowgate:change-me@localhost:5432/knowgate

# --- Redis (docker-compose) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Auth (phase 1b) ---
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=15m

# --- Claude API (phase 3) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# --- Voyage AI embeddings (phase 2) ---
VOYAGE_API_KEY=
# Model and dimension to be confirmed in the Voyage docs in phase 2
VOYAGE_MODEL=
EMBEDDING_DIMENSION=

# --- Usage limits (phase 3) ---
# Default daily token limit for new organizations
DAILY_TOKEN_LIMIT_DEFAULT=200000

# --- Uploads (phase 2) ---
# 10 MB
UPLOAD_MAX_BYTES=10485760
