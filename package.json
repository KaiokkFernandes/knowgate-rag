{
  "name": "knowgate",
  "version": "0.0.0",
  "private": true,
  "description": "Internal knowledge assistant with RAG, tenant isolation, PII masking and LLM cost control.",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --filter @knowgate/shared build && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "node scripts/check-env-example.mjs && pnpm -r lint",
    "typecheck": "pnpm --filter @knowgate/shared build && pnpm -r typecheck",
    "test": "pnpm --filter @knowgate/shared build && pnpm -r test",
    "test:integration": "pnpm -r --if-present test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @knowgate/db migrate",
    "db:generate": "pnpm --filter @knowgate/db generate",
    "db:reset": "pnpm --filter @knowgate/db reset",
    "db:studio": "pnpm --filter @knowgate/db studio",
    "lint:env": "node scripts/check-env-example.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.6.6",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
