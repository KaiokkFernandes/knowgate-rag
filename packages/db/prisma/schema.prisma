// KnowGate database schema. Ids are UUIDv7 generated by Postgres 18 (time-ordered).
// Hand-written SQL (extensions, text search config, Chunk) lives in prisma/migrations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

enum DocumentSourceType {
  PDF
  MARKDOWN
  TXT
}

enum DocumentVisibility {
  ORG
  TEAMS
}

enum DocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum MessageRole {
  USER
  ASSISTANT
}

enum UsageKind {
  CHAT
  EMBEDDING
  CONTEXTUALIZE
}

model Organization {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name            String
  dailyTokenLimit Int
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  memberships   Membership[]
  teams         Team[]
  documents     Document[]
  conversations Conversation[]
  usageEvents   UsageEvent[]
}

model User {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email        String   @unique // normalized to lowercase by the application
  passwordHash String
  name         String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  memberships      Membership[]
  createdDocuments Document[]
  conversations    Conversation[]
  usageEvents      UsageEvent[]
  sessions         Session[]
}

/// Refresh token session. Only the SHA-256 of the token is stored: a database leak does
/// not reveal usable tokens. Each refresh rotates the token (replacedById chains the
/// rotation); presenting a revoked token is treated as theft and revokes every session.
model Session {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime  @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  replacedById String?   @unique @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy Session? @relation("SessionRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   Session? @relation("SessionRotation")

  @@index([userId])
}

model Membership {
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  role           Role     @default(MEMBER)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamMembers  TeamMember[]

  @@id([organizationId, userId]) // also serves "members of an organization"
  @@index([userId]) // "organizations of a user"
}

model Team {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members       TeamMember[]
  documentTeams DocumentTeam[]

  @@unique([organizationId, name])
  @@unique([organizationId, id]) // target of the tenant-safe composite FKs
}

model TeamMember {
  organizationId String   @db.Uuid
  teamId         String   @db.Uuid
  userId         String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  // Both FKs carry organizationId: a user can only join a team of an org they belong to.
  team       Team       @relation(fields: [organizationId, teamId], references: [organizationId, id], onDelete: Cascade)
  membership Membership @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([organizationId, userId])
}

model Document {
  id             String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String             @db.Uuid
  title          String
  sourceType     DocumentSourceType
  visibility     DocumentVisibility @default(ORG)
  status         DocumentStatus     @default(PENDING)
  createdById    String?            @db.Uuid
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(3)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // The document belongs to the organization: deleting its author keeps it.
  createdBy     User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  documentTeams DocumentTeam[]
  chunks        Chunk[]

  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([createdById])
}

model DocumentTeam {
  organizationId String   @db.Uuid
  documentId     String   @db.Uuid
  teamId         String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  // A document can only be shared with teams of its own organization.
  document Document @relation(fields: [organizationId, documentId], references: [organizationId, id], onDelete: Cascade)
  team     Team     @relation(fields: [organizationId, teamId], references: [organizationId, id], onDelete: Cascade)

  @@id([documentId, teamId])
  @@index([teamId])
}

/// External table (see prisma.config.ts, tables.external): its DDL lives in hand-written
/// migrations because Prisma cannot represent the HNSW index nor the generated tsvector
/// column. Reads and writes go through ChunkRepository ($queryRaw).
model Chunk {
  id             String                       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String                       @db.Uuid
  documentId     String                       @db.Uuid
  position       Int
  content        String
  context        String?
  reference      String?
  tokenCount     Int
  embedding      Unsupported("vector(1024)")?
  searchVector   Unsupported("tsvector")?
  createdAt      DateTime                     @default(now()) @db.Timestamptz(3)

  // organizationId is denormalized (tenant filter without join); this composite FK
  // guarantees it always matches the document's organization.
  document Document @relation(fields: [organizationId, documentId], references: [organizationId, id], onDelete: Cascade)

  @@unique([documentId, position])
  @@index([organizationId])
}

model Conversation {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@index([organizationId, userId, createdAt])
  @@index([userId])
}

model Message {
  id             String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  conversationId String      @db.Uuid
  role           MessageRole
  content        String
  citations      Json?
  inputTokens    Int         @default(0)
  outputTokens   Int         @default(0)
  costUsd        Decimal     @default(0) @db.Decimal(12, 6)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model UsageEvent {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String    @db.Uuid
  userId         String?   @db.Uuid
  kind           UsageKind
  model          String
  inputTokens    Int       @default(0)
  outputTokens   Int       @default(0)
  costUsd        Decimal   @db.Decimal(12, 6) // money: never Float
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Cost history survives user deletion.
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt]) // daily usage sums
  @@index([userId])
}
